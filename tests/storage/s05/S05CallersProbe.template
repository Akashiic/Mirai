 static void propagateTests() throws Exception {
  Propagator rejected=new Propagator();rejected.updatingPosSet.clear();PriorityTaskPicker.Executor executor=new PriorityTaskPicker.Executor();executor.reject=true;
  rejected.runParentUpdates(executor,new DhBlockPos());yes(rejected.updatingPosSet.isEmpty(),"rejected upward queue marker released");eq(4,rejected.provider.repo.up.size(),"rejected upward keeps flags");
  rejected.runChildUpdates(executor,new DhBlockPos());yes(rejected.updatingPosSet.isEmpty(),"rejected downward queue marker released");yes(rejected.provider.repo.down.contains(100L),"rejected downward keeps flags");
  Propagator p=new Propagator();p.propagateChildrenToParent(100,children());yes(p.provider.repo.up.isEmpty(),"parent ack clears represented children");eq(1,p.dataUpdater.writes.size(),"one parent write");unlocked(p);
  p=new Propagator();p.dataUpdater.fail=100;p.propagateChildrenToParent(100,children());eq(4,p.provider.repo.up.size(),"parent failure keeps all flags");unlocked(p);
  p=new Propagator();p.provider.missing.add(3L);p.propagateChildrenToParent(100,children());eq(0,p.dataUpdater.writes.size(),"missing child no partial parent ack");eq(4,p.provider.repo.up.size(),"missing child flags remain");unlocked(p);
  final Propagator busy=new Propagator();CountDownLatch held=new CountDownLatch(1),release=new CountDownLatch(1);
  Thread holder=new Thread(()->{ReentrantLock l=busy.dataUpdater.updateLockProvider.getLock(3);l.lock();try{held.countDown();release.await();}catch(InterruptedException e){throw new AssertionError(e);}finally{l.unlock();}});holder.start();yes(held.await(5,TimeUnit.SECONDS),"busy fixture ready");
  busy.propagateChildrenToParent(100,children());eq(0,busy.dataUpdater.writes.size(),"busy child aborts without write");eq(4,busy.provider.repo.up.size(),"busy child preserves flags");yes(!busy.dataUpdater.updateLockProvider.getLock(1).isLocked(),"earlier acquired lock released on busy child");release.countDown();holder.join(5000);yes(!holder.isAlive(),"busy fixture exited");unlocked(busy);
  final Propagator race=new Propagator();final Thread[] newer={null};CountDownLatch attempt=new CountDownLatch(1);
  race.dataUpdater.beforeWrite=d->{
   yes(race.dataUpdater.updateLockProvider.getLock(1).isHeldByCurrentThread(),"child lock held through parent commit");
   newer[0]=new Thread(()->{attempt.countDown();ReentrantLock l=race.dataUpdater.updateLockProvider.getLock(1);l.lock();try{race.provider.repo.up.add(1L);}finally{l.unlock();}});newer[0].start();try{yes(attempt.await(5,TimeUnit.SECONDS),"new writer started");}catch(InterruptedException e){throw new AssertionError(e);}
  };race.propagateChildrenToParent(100,children());newer[0].join(5000);yes(!newer[0].isAlive(),"new writer completed after unlock");yes(race.provider.repo.up.contains(1L),"newer child update not erased by old parent ack");unlocked(race);
  p=new Propagator();p.propagateParentToChildren(100);eq(4,p.dataUpdater.writes.size(),"all four children committed");yes(p.provider.repo.down.isEmpty(),"four acks clear parent dirty flag");unlocked(p);
  p=new Propagator();p.dataUpdater.fail=3;p.propagateParentToChildren(100);eq(2,p.dataUpdater.writes.size(),"partial child writes");yes(p.provider.repo.down.contains(100L),"partial failure keeps parent dirty");unlocked(p);
  p=new Propagator();p.provider.missing.add(2L);p.propagateParentToChildren(100);yes(p.provider.repo.down.contains(100L),"missing child keeps parent dirty");unlocked(p);
  p=new Propagator();p.isShutdownRef.set(true);p.propagateChildrenToParent(100,children());eq(0,p.dataUpdater.writes.size(),"shutdown no write");eq(4,p.provider.repo.up.size(),"shutdown no ack");unlocked(p);
 }
